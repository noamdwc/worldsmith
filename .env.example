# Copy to .env and set your bucket and external credentials-file path.
R2_BUCKET=your-bucket-name
R2_CREDENTIALS_FILE=${HOME}/.config/colab-utils/r2.env

# Uncomment if your Colab CLI needs an explicit trusted CA bundle (macOS).
# SSL_CERT_FILE=/etc/ssl/cert.pem
# WEBSOCKET_CLIENT_CA_BUNDLE=/etc/ssl/cert.pem
