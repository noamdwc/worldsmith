#!/bin/sh
set -eu

usage() {
    echo 'Usage: ./worldsmith-eval RUN_NAME [--seed N]' >&2
    exit 2
}

run_name=${1:-}
case "$run_name" in
    ''|*[!a-zA-Z0-9_-]*) usage ;;
esac
shift

case $# in
    0) set -- --split dev ;;
    2) [ "$1" = --seed ] || usage ;;
    *) usage ;;
esac

cd "$(dirname "$0")/.."
exec uv run --locked python -m worldsmith evaluate \
    --controller autoresearch.controller:make_controller \
    --output "autoresearch/runs/$run_name" "$@"
